#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p "$root/demo/repositories"
mode="${1:-historical}"
case "$mode" in
 historical) repo=qimingnan/copay; directory=copay-2018; ref=23a0eae16283549d0e53cc4f6a5719d2cca6d89e; script=historical.py ;;
 real) repo=PanJiaChen/vue-admin-template; directory=vue-admin-template; ref=4c18a3f47bdb417ad8a25f09910f848cb574dee2; script=real_repo.py ;;
 *) echo 'Usage: kb-real-review [historical|real]' >&2; exit 2 ;;
esac
checkout="$root/demo/repositories/$directory"
if [[ ! -d "$checkout/.git" ]]; then
 git init "$checkout"
 git -C "$checkout" remote add origin "https://github.com/$repo.git"
 git -C "$checkout" fetch --depth 1 origin "$ref"
 git -C "$checkout" checkout --detach FETCH_HEAD
fi
[[ "$(git -C "$checkout" rev-parse HEAD)" == "$ref" ]] || { echo 'Source commit mismatch; refusing review.' >&2; exit 1; }
cd "$root"
python3 "demo/$script"
